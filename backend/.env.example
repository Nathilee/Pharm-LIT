# Copy to .env and fill in. All values are optional in development.
PORT=4000

# Secret used to sign login tokens. CHANGE THIS in production.
JWT_SECRET=change-me-to-a-long-random-string

# Paystack keys (https://dashboard.paystack.com/#/settings/developers).
# Leave PAYSTACK_SECRET_KEY empty to use the built-in demo checkout.
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=GHS

# Public URL of this API (used for Paystack callback redirects), e.g. https://api.pharmlit.com
PUBLIC_URL=

# Default admin account created on first run
ADMIN_EMAIL=admin@pharmlit.com
ADMIN_PASSWORD=admin123
